# Copy to bridge/.env, fill in, then: chmod 600 bridge/.env
# This file is gitignored. Never commit the real one.

# From @BotFather when you create the bot (/newbot). Treat it like a password:
# anyone holding it can send and receive as your bot.
TELEGRAM_BOT_TOKEN=

# YOUR chat ID, and only yours. Get it by messaging @userinfobot on Telegram.
# The bridge REFUSES TO START if this is empty -- an open allowlist would give
# any Telegram user free inference on this machine. Comma or space separated
# if you ever need more than one.
TELEGRAM_ALLOWED_CHAT_IDS=

# Defaults below are fine; override only if you know why.
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=llama3.2
BRIDGE_LOG_PATH=/home/foe/server/logs/bridge.log
